# Mapbox Video Studio - Environment Configuration Template
# Copy this file to .env or set window.MAPBOX_TOKEN in your local environment.
# 
# IMPORTANT:
# - Use ONLY public-scoped tokens (pk.*).
# - NEVER put secret-scoped tokens (sk.*) here or in any client-facing code.
# - In production, restrict this token to your specific domain via account.mapbox.com.

VITE_MAPBOX_TOKEN=pk.your_public_mapbox_token_here
MAPBOX_ACCESS_TOKEN=pk.your_public_mapbox_token_here
