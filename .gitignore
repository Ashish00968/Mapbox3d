# .gitignore for Mapbox Video Studio

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Dependencies
node_modules/
jspm_packages/

# Environment files and credentials (CRITICAL: Never commit these)
.env
.env.*
!.env.example
*.local

# Editor directories and configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build and distribution outputs
dist/
build/
out/
.cache/

# Test and coverage artifacts
coverage/
*.lcov
.nyc_output/

# Temporary / scratch scripts
fix_html.py
